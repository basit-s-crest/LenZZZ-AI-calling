# .env.example
# Twilio credentials and configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
BASE_URL=http://localhost:8080

# AI Voice Agent (Free Tier / Providers)
# LLM: Groq (Free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# STT: Deepgram ($200 free credit at https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_STT_MODEL=nova-3-general

# TTS: Cartesia (Free credits at https://cartesia.ai) or Deepgram Aura
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=248be419-c632-4f23-adf1-5324ed7dbf10
